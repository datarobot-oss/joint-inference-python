# Service configuration. Copy to .env (git-ignored) and fill in; the Taskfile
# targets serve, probe, and docker:run read it, and docker:run passes it to the
# container as an --env-file, so write values without quotes.

# Where the checkpoint file is, or is downloaded to. docker:run mounts this
# file's directory into the container.
JOINTFM_INFERENCE_CHECKPOINT_PATH=
# The checkpoint's version label, reported by /healthz as checkpoint_version.
JOINTFM_INFERENCE_CHECKPOINT_VERSION=

# Download source. Leave the URL empty to serve a file already at the path.
# With a URL, the SHA-256 digest is required: a present file is reused only
# when it matches, and a download is verified before it is moved into place.
JOINTFM_INFERENCE_CHECKPOINT_URL=
JOINTFM_INFERENCE_CHECKPOINT_SHA256=
# Optional bearer token, sent only to an https URL.
JOINTFM_INFERENCE_CHECKPOINT_TOKEN=

# Optional settings; uncomment and set one to override its default (README).
# Torch device the model runs on, such as cpu or cuda:0.
# JOINTFM_INFERENCE_DEVICE=
# Device the checkpoint tensors are first read onto; follows the device.
# JOINTFM_INFERENCE_MAP_LOCATION=
# Model precision of every forward: fp32, bf16, or fp16.
# JOINTFM_INFERENCE_PRECISION=
# Address and port a local serve binds; docker:run maps the port to the host.
# JOINTFM_INFERENCE_BIND_HOST=
# JOINTFM_INFERENCE_PORT=
# Largest sample count one request may ask for.
# JOINTFM_INFERENCE_MAX_SAMPLE_COUNT=
# Prediction requests one process runs at the same time.
# JOINTFM_INFERENCE_MAX_CONCURRENT_REQUESTS=
# Model version /healthz reports; a request naming a model version must match it.
# JOINTFM_INFERENCE_MODEL_VERSION=
