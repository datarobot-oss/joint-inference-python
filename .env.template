# Service configuration. Copy to .env (git-ignored) and fill in, or run
# task start to have the DataRobot CLI (dr) write it; the Taskfile targets
# read it, and docker:run passes the JOINTFM_INFERENCE_* settings on to the
# container.

# Where the checkpoint file is, or is downloaded to. docker:run mounts this
# file's directory into the container. The service reports the start of the
# file's SHA-256 digest as the checkpoint version.
JOINTFM_INFERENCE_CHECKPOINT_PATH=

# Download source. Leave the URL empty to serve a file already at the path.
# With a URL, the SHA-256 digest is required: a present file is reused only
# when it matches, and a download is verified before it is moved into place.
JOINTFM_INFERENCE_CHECKPOINT_URL=
JOINTFM_INFERENCE_CHECKPOINT_SHA256=
# Optional bearer token, sent only to an https URL.
JOINTFM_INFERENCE_CHECKPOINT_TOKEN=

# Request schema version jointfm-client callers send; the service reads only
# its built-in version, so this value only has to match it.
JOINTFM_SCHEMA_VERSION=v6

# Optional settings; uncomment and set one to override its default (README).
# Torch device the model runs on, such as cpu or cuda:0.
# JOINTFM_INFERENCE_DEVICE=
# Device the checkpoint tensors are first read onto; follows the device.
# JOINTFM_INFERENCE_MAP_LOCATION=
# Model precision of every forward: fp32, bf16, or fp16.
# JOINTFM_INFERENCE_PRECISION=
# Address and port a local serve binds; docker:run maps the port to the host.
# JOINTFM_INFERENCE_BIND_HOST=
# JOINTFM_INFERENCE_PORT=
# Largest sample count one request may ask for.
# JOINTFM_INFERENCE_MAX_SAMPLE_COUNT=
# Prediction requests one process runs at the same time.
# JOINTFM_INFERENCE_MAX_CONCURRENT_REQUESTS=
# Model version /healthz reports; a request naming a model version must match it.
# JOINTFM_INFERENCE_MODEL_VERSION=

# Deploying to DataRobot (task deploy:*). The deploy bundles the checkpoint
# file at JOINTFM_INFERENCE_CHECKPOINT_PATH into the image and passes the
# optional service settings above to the container; a GPU bundle sets the
# device to cuda.
# DataRobot API endpoint, ending in /api/v2, and an API token for it.
DATAROBOT_ENDPOINT=https://app.datarobot.com/api/v2
DATAROBOT_API_TOKEN=
# Pulumi keeps deploy state in this backend; unset means file://~ (~/.pulumi).
# PULUMI_BACKEND_URL=
# Encrypts secrets in that state; required by the file backend, may be empty.
PULUMI_CONFIG_PASSPHRASE=
# Stack name: one Workload per stack. Unset means dev.
# JOINTFM_DEPLOY_STACK=
# Resource bundle each replica runs on; task deploy:bundles lists the IDs the
# cluster offers. Unset means cpu.5xlarge. On app.datarobot.com,
# DRAWS_g5.2xlarge_frac1_regular is one NVIDIA A10G with 24 GB.
JOINTFM_DEPLOY_BUNDLE=
# Optional overrides of the container's share of the bundle, which the deploy
# refuses when they exceed it. Memory accepts sizes such as 8GB or 4096Mi; GPU
# is a device count.
# JOINTFM_DEPLOY_CPU=
# JOINTFM_DEPLOY_MEMORY=
# JOINTFM_DEPLOY_GPU=
# Replica count. Unset means 1.
# JOINTFM_DEPLOY_REPLICAS=
